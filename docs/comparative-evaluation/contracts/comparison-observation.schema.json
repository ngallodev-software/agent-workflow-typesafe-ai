{
  "$defs": {
    "arm": {
      "additionalProperties": false,
      "properties": {
        "duration_seconds": {
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "error_class": {
          "type": [
            "string",
            "null"
          ]
        },
        "first_output_latency_seconds": {
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "provider_elapsed_seconds": {
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "result": {
          "type": [
            "object",
            "null"
          ]
        },
        "status": {
          "enum": [
            "success",
            "error",
            "timeout",
            "skipped",
            "not_applicable"
          ]
        },
        "usage": {
          "type": "object"
        }
      },
      "required": [
        "status",
        "duration_seconds",
        "result",
        "usage"
      ],
      "type": "object"
    }
  },
  "$id": "agent-workflow-typesafe/comparison-observation/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate": {
      "$ref": "#/$defs/arm"
    },
    "comparison": {
      "additionalProperties": false,
      "properties": {
        "agreement": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "authoritative_arm": {
          "enum": [
            "control",
            "candidate",
            "none"
          ]
        },
        "candidate_applied": {
          "type": "boolean"
        },
        "normalized_candidate": {},
        "normalized_control": {}
      },
      "required": [
        "candidate_applied",
        "authoritative_arm"
      ],
      "type": "object"
    },
    "control": {
      "$ref": "#/$defs/arm"
    },
    "feature_id": {
      "minLength": 1,
      "type": "string"
    },
    "identity": {
      "type": "object"
    },
    "input": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "projection_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "raw_input_persisted": {
          "const": false
        }
      },
      "required": [
        "input_sha256",
        "projection_sha256"
      ],
      "type": "object"
    },
    "mode": {
      "enum": [
        "static",
        "shadow-normal-usage",
        "guarded-experiment"
      ]
    },
    "observation_id": {
      "minLength": 1,
      "type": "string"
    },
    "privacy": {
      "additionalProperties": false,
      "properties": {
        "data_class": {
          "enum": [
            "synthetic",
            "redacted-production",
            "production-metadata"
          ]
        },
        "raw_content_stored": {
          "const": false
        },
        "secret_values_stored": {
          "const": false
        }
      },
      "required": [
        "data_class",
        "raw_content_stored",
        "secret_values_stored"
      ],
      "type": "object"
    },
    "recorded_at": {
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "const": "agent-workflow-typesafe/comparison-observation/v1"
    }
  },
  "required": [
    "schema",
    "observation_id",
    "feature_id",
    "mode",
    "recorded_at",
    "identity",
    "input",
    "control",
    "candidate",
    "comparison",
    "privacy"
  ],
  "type": "object"
}
