{
  "$id": "agent-workflow-typesafe/semantic-advice/v1alpha1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "question_set_version", "request_sha256", "source_refs", "host_version", "status", "fallback", "policy_outcome", "advisory", "answers", "model"],
  "properties": {
    "schema": {"const": "semantic-advice/v1alpha1"},
    "kind": {"enum": ["routing", "skill_evaluation"]},
    "question_set_version": {"type": "string"},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_refs": {"type": "array", "items": {"type": "string"}},
    "host_version": {"type": "string"},
    "status": {"type": "string"},
    "fallback": {"const": "no_action"},
    "policy_outcome": {"const": "no_action"},
    "advisory": {"const": true},
    "answers": {"type": "object"},
    "model": {"type": ["string", "null"]},
    "error": {"type": "string"}
  }
}
